                                        "suggest_items": "[{\"suggest\":\"资讯：联合国人工智能小组首次会议召开\",\"background_color\":\"\",\"dark_background_color\":\"\",\"item_id\":\"40820513956986626\",\"item_type\":\"103\",\"sending_content\":\"资讯：联合国人工智能小组首次会议召开\",\"is_immersive_mode\":null,\"light_url_item\":null,\"dark_url_item\":null,\"front_light_url_item\":null,\"front_dark_url_item\":null,\"wcb_item\":\"{\\\"item_id\\\":40820513956986626,\\\"send_content\\\":\\\"资讯：联合国人工智能小组首次会议召开\\\",\\\"group_source\\\":26}\",\"is_highlight_push\":false,\"extra\":{\"candidate_type\":\"SugNewHotspot\",\"template_rec_extra\":\"{\\\"group_cluster_id\\\":\\\"0\\\",\\\"creation_type\\\":\\\"0\\\"}\",\"reco_request_id\":\"20260329143046F7B8D3496D7A70EBEEEE\",\"prompt_from\":\"new_topic\"}},{\"suggest\":\"生成女生豹纹上衣都市夜景写真\",\"background_color\":\"\",\"dark_background_color\":\"\",\"item_id\":\"30279665006586114\",\"item_type\":\"103\",\"sending_content\":\"生成图片：时尚都市夜景风格写真，以黄昏时分的城市运动场为背景，年轻女性模特侧身站立，左手叉腰，身体略微倾斜，呈现自信姿态。模特身着豹纹无袖上衣，凸显身材曲线，冷静神情直视镜头，传递出魅惑与自信的情绪。妆容精致，强调眼部轮廓与红唇，增强画面的视觉冲击力。背景为黄昏天空与运动场灯光架，温暖光线与暖色调滤镜营造出强烈的明暗对比，高对比度与锐利细节增强画面质感。采用电影感构图，专业灯光处理突出主体同时保留环境细节，完美呈现都市夜晚的时尚氛围与情绪张力。整体画面融合了都市运动场场景、豹纹服饰、灯光架等元素，通过精准的光影控制与色彩处理，呈现出具有强烈视觉冲击力的时尚影像，适合表达现代都市女性的自信与魅力。\",\"icon_url\":\"https:\u002F\u002Fp11-flow-imagex-sign.byteimg.com\u002Ftos-cn-i-a9rns2rl98\u002FEffect_2_Stroke_Light.png~tplv-a9rns2rl98-image-qvalue.image?rk3s=b78b666b&x-expires=1774987062&x-signature=8y4BB9yITc4J7hM7V7PlWGSDMDg%3D\",\"dark_icon_url\":\"https:\u002F\u002Fp3-flow-imagex-sign.byteimg.com\u002Ftos-cn-i-a9rns2rl98\u002FEffect_2_Stroke_Dark.png~tplv-a9rns2rl98-image-qvalue.image?rk3s=b78b666b&x-expires=1774987062&x-signature=aVDcK0Ig1EU2aPOupAMfAt8kmbc%3D\",\"is_immersive_mode\":null,\"light_url_item\":{\"uri\":\"tos-cn-i-a9rns2rl98\u002FEffect_2_Stroke_Light.png\",\"url\":\"https:\u002F\u002Fp11-flow-imagex-sign.byteimg.com\u002Ftos-cn-i-a9rns2rl98\u002FEffect_2_Stroke_Light.png~tplv-a9rns2rl98-image-qvalue.image?rk3s=b78b666b&x-ex