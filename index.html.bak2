                                                    }
                                                }],
                                                "icon_url": "https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fdvsm\u002FljhwZthlaukjlkulzlp\u002Ftool_icon\u002FSearch.png",
                                                "icon_url_dark": "https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fdvsm\u002FljhwZthlaukjlkulzlp\u002Ftool_icon\u002FSearch-1.png",
                                                "vlm_rich_media_results": [],
                                                "scene": 2,
                                                "search_type": 1,
                                                "extend_fields": {
                                                    "thinking_idx": 2
                                                }
                                            },
                                            "pc_event_block": ""
                                        },
                                        "meta_info": [],
                                        "is_finish": true,
                                        "append_fields": []
                                    }],
                                    "tts_content": "这里说的**教育版小龙虾（教育龙虾\u002F龙虾老师）**，不是美食，而是清华大学教育学院+计算机系团队2026年3月16日正式开源的多智能体AI课堂项目 **OpenMAIC**（常和热门AI智能体OpenClaw（小龙虾）关联称呼）。\n\n### 核心信息\n1.  **定位**：一键生成完整AI虚拟课堂，有AI老师授课、AI助教辅助、AI同学举手讨论的沉浸式互动场景；支持PDF\u002FPPT导入自动生成课件，也能文字指令从零创建。\n2.  **体验&部署**：在线地址 https:\u002F\u002Fopen.maic.chat\u002F；GitHub开源地址 https:\u002F\u002Fgithub.com\u002FTHU-MAIC\u002FOpenMAIC；支持主流大模型（Qwen、GLM、GPT等），可本地部署，课件能导出PPT和HTML。\n3.  **优势**：大幅降低备课成本，生成速度快，语音+白板书写+随堂测验+讨论互动一体化，适合K12、高校、职业培训等多场景。\n4.  **名称由来**：因OpenClaw（图标是红龙虾，俗称小龙虾）爆火，清华这款专注教育场景的多智能体系统被网友称为**教育版小龙虾\u002F龙虾老师**。\n\n\n我可以帮你整理一份**OpenMAIC本地部署的极简步骤清单**，需要吗？",
